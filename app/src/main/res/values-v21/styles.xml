<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Base application theme for API 21+. This theme completely replaces
        AppBaseTheme from BOTH res/values/styles.xml and
        res/values-v11/styles.xml on API 21+ devices.
    -->
    <style name="AppBaseTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <!-- API 21 theme customizations can go here. -->
        <item name="android:imageButtonStyle">@style/image_button</item>
        <item name="android:navigationBarColor">@color/navigation_background</item>
        <item name="android:colorAccent">@color/color_default_accent</item>
        <item name="android:colorControlNormal">@color/color_default_icon</item>
        <item name="android:windowBackground">@color/color_default_background</item>
        <item name="colorAccent">@color/color_default_accent</item>
    </style>
    <style name="image_button" parent="@android:style/Widget.Material.ImageButton">
        <item name="android:backgroundTint">#d05a595b</item> <!-- standard material design backgroundTint is #ff5a595b, but we want transparent image buttons -->
    </style>
    
</resources>
